# Backend
PORT=8080
# Port pengembangan lokal (task dev/frontend) — dipisah dari port Docker Compose
DEV_BACKEND_PORT=8081
DEV_FRONTEND_PORT=3002
# Host binding dev frontend; harus sama dengan host pada DEV_FRONTEND_URL agar
# Origin browser cocok dengan FRONTEND_PUBLIC_URL (CORS & pemeriksaan Origin).
DEV_FRONTEND_HOST=127.0.0.1
POSTGRES_HOST_PORT=5433
DEV_BACKEND_URL=http://127.0.0.1:8081
DEV_FRONTEND_URL=http://127.0.0.1:3002

# Frontend (URL internal/container backend pada deployment)
BACKEND_URL=http://localhost:8080
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080

# Port host untuk Docker Compose
BACKEND_PORT=8080
FRONTEND_PORT=3000

# PostgreSQL baru untuk development. Volume MySQL lama tidak disentuh atau dimigrasikan.
POSTGRES_DB=sitani
POSTGRES_USER=sitani
POSTGRES_PASSWORD=ganti-dengan-password-kuat

# Password hanya berlaku saat volume dibuat; mengubahnya setelah volume ada
# tidak mengubah akun PostgreSQL dan menyebabkan autentikasi gagal.
# SSO Jogjaprov (nilai issuer/client harus dikonfirmasi pengelola SSO)
SSO_JSP_ISSUER=https://sso.jogjaprov.go.id/realms/jsp
SSO_JSP_CLIENT_ID=portal
# Client secret hanya bila client di Keycloak bertipe confidential. Biarkan
# kosong untuk client publik (PKCE). Jangan commit nilai sebenarnya.
SSO_JSP_CLIENT_SECRET=
SSO_SATRIYA_ISSUER=https://sso.jogjaprov.go.id/realms/satriya
SSO_SATRIYA_CLIENT_ID=portal
SSO_SATRIYA_CLIENT_SECRET=
BACKEND_PUBLIC_URL=http://localhost:8080
FRONTEND_PUBLIC_URL=http://localhost:3000
SSO_COOKIE_SECURE=false
# Sisa umur minimum (detik) access token sebelum diperbarui dengan refresh
# token. 0 atau kosong memakai nilai bawaan 60 detik.
SSO_REFRESH_SKEW_SECONDS=60
# Toleransi selisih jam (detik) saat memverifikasi exp/iat/nbf token SSO.
SSO_TOKEN_LEEWAY_SECONDS=60

# Login lokal development/UAT (lihat docs/login-lokal-development.md).
# Biarkan kosong/false di produksi: login lokal otomatis mati bila
# APP_ENV/GO_ENV/ENVIRONMENT/SITANI_ENV=production atau SENTRY_ENVIRONMENT=production.
SITANI_DEV_LOGIN=false
# Password akun seed-dev; isi hanya saat menjalankan `go run ./cmd/seed-dev`.
SEED_DEV_PASSWORD=

# Object Storage MinIO (kosong = fitur dokumen 503 dengan pesan jelas;
# layanan dev tersedia lewat profil compose "minio")
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=sitani-dokumen
MINIO_SECURE=false
MINIO_MAX_UPLOAD_MB=20

#configure SPL Base URL Jogjaprov
SPL_BASE_URL=
SPL_TIMEOUT_SECONDS=10

# Asisten AI (penyedia kompatibel OpenAI, mis. GripHub Router).
# Kosong = endpoint /v1/ai/chat terdaftar tetapi menjawab 503.
# API key hanya dibaca backend; jangan isi NEXT_PUBLIC_* dengan nilai ini.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=90
AI_MAX_REQUESTS_PER_MINUTE=10

# Notifikasi Discord (kosong = tidak mengirim)
DISCORD_WEBHOOK_URL=

# Error logging Sentry (kosong = tidak mengirim; DSN opsional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=dev
